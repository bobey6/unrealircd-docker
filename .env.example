# DOMAIN is the network label shown in server info blocks.
DOMAIN=example.org
# IRCDOMAIN is the public hostname clients use to connect; certbot issues for this value.
IRCDOMAIN=irc.example.org
OPERNAME=admin
OPERPASS=change_me
LETSENCRYPT_EMAIL=admin@example.org

# Optional: override auto-generated 80-100 character alphanumeric cloak keys
# CLOAKKEY1=override_key_1
# CLOAKKEY2=override_key_2
# CLOAKKEY3=override_key_3

# Optional: Let's Encrypt challenge method (http-01 | dns-01)
# CERTBOT_CHALLENGE=http-01

# If using dns-01, choose a supported plugin and provide credentials
# Supported plugins baked-in: cloudflare, digitalocean
# CERTBOT_DNS_PLUGIN=cloudflare
# Option A: provide a credentials file
# CERTBOT_DNS_CREDENTIALS=/run/secrets/cloudflare.ini
# Option B: provide token in env (no file needed)
# DNS_CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
# DNS_DIGITALOCEAN_TOKEN=your_digitalocean_token
# CERTBOT_DNS_PROPAGATION_SECONDS=60