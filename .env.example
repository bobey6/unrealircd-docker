# DOMAIN is the network label shown in server info blocks.
DOMAIN=example.org
# IRCDOMAIN is the public hostname clients use to connect; certbot issues for this value.
IRCDOMAIN=irc.example.org
OPERNAME=admin
OPERPASS=change_me
LETSENCRYPT_EMAIL=admin@example.org

# Optional: override auto-generated 80-100 character alphanumeric cloak keys
# CLOAKKEY1=override_key_1
# CLOAKKEY2=override_key_2
# CLOAKKEY3=override_key_3